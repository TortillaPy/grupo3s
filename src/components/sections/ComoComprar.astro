---
import { Icon } from 'astro-icon/components';

import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import { config, obtenerContenido } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const { comoComprar, hero, presupuesto } = obtenerContenido(locale);
---

<Section
  id="como-comprar"
  volanta="Cómo trabajamos"
  titulo={comoComprar.titulo}
  bajada={comoComprar.bajada}
  fondo="blanco"
>
  <!--
    Acá la numeración no es decorativa: los pasos ocurren en este orden y
    el número le dice al lector dónde está del proceso.
  -->
  <ol class="relative grid gap-8 sm:grid-cols-3 sm:gap-6 lg:gap-10">
    <!--
      Línea que une los tres pasos. Existe solo desde `sm`, que es
      donde los pasos van en fila y la línea significa "esto sigue a
      esto"; apilados en móvil no aportaría nada.
    -->
    <span
      class="absolute top-6 right-[16.67%] left-[16.67%] hidden h-px bg-gris-claro sm:block"
      aria-hidden="true"></span>

    {
      comoComprar.pasos.map((paso, indice) => (
        <li
          class="relative"
          data-revelar
          data-revelar-retraso={String(indice * 110)}
        >
          {/*
            El número va en un disco verde sobre la línea. Es el ancla
            visual del paso: se ve de un vistazo cuántos pasos hay y en
            cuál se está.
          */}
          <span
            class="relative z-10 inline-flex size-12 items-center justify-center rounded-full bg-verde-oscuro font-display text-[1.05rem] font-bold tabular-nums text-white shadow-[0_8px_20px_-10px_rgb(30_90_34/0.8)] dark:bg-[#2c7d31]"
            aria-hidden="true"
          >
            {String(indice + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-5 font-display text-[1.15rem] font-bold text-negro">
            {paso.titulo}
          </h3>
          <p class="mt-2 max-w-lectura text-[0.95rem] text-grafito/85">{paso.texto}</p>
        </li>
      ))
    }
  </ol>

  <div
    class="tarjeta mt-14 flex flex-col gap-5 bg-hueso p-6 sm:mt-16 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    data-revelar
  >
    <div>
      <p class="font-display text-[1.15rem] font-bold text-negro">
        {presupuesto.titulo}
      </p>
      <p class="mt-1 max-w-lectura text-[0.95rem] text-grafito/85">
        {presupuesto.bajada}
      </p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <WhatsAppLink contexto={{ tipo: 'general' }} locale={locale}>
        <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
        {hero.ctaPrimario}
      </WhatsAppLink>
      <Button href={`tel:+${config.contacto.telefonos[0]?.e164 ?? config.contacto.whatsapp.e164}`} variante="secundario">
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
        {config.contacto.telefonos[0]?.visible ?? config.contacto.whatsapp.visible}
      </Button>
    </div>
  </div>
</Section>
