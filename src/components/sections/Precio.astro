---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import Section from '../ui/Section.astro';
import { buildWhatsAppUrl, config, obtenerContenido, productosDestacados, ATRIBUTOS_ENLACE_EXTERNO } from '@data/site';
import type { Locale, Precio as PrecioTipo } from '@data/site';
import { resolverImagen } from '../../lib/imagenes';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const contenido = obtenerContenido(locale);
const { precio } = contenido;

/**
 * Interruptor único de precios.
 *
 * Con `config.precios.isVisible` en `false` no se renderiza ningún
 * importe y el JSON-LD tampoco emite `offers` (ver Layout.astro).
 * Prender el booleano en config.ts activa las dos cosas a la vez.
 */
const mostrarPrecios = config.precios.isVisible;

const formateador = new Intl.NumberFormat('es-PY', {
  style: 'currency',
  currency: config.precios.moneda,
  maximumFractionDigits: 0,
});

function formatearPrecio(valor: PrecioTipo | undefined): string | undefined {
  if (valor === undefined) return undefined;
  return formateador.format(valor.monto);
}

const items = productosDestacados.map((producto) => ({
  producto,
  copy: contenido.productos[producto.slug],
  modulo: resolverImagen(producto.imagen.src),
}));
---

<Section
  id="presupuesto"
  volanta="Precio y presentaciones"
  titulo={precio.titulo}
  bajada={precio.bajada}
  fondo="blanco"
>
  <ul class="grid gap-4 sm:gap-5 lg:grid-cols-2">
    {
      items.map(({ producto, copy, modulo }, indice) => (
        <li
          class="tarjeta flex flex-col gap-4 p-5 sm:flex-row sm:gap-5 sm:p-6"
          data-revelar
          data-revelar-retraso={String((indice % 2) * 90)}
        >
          <div class="plinto plinto-sombra grid h-32 w-full shrink-0 place-items-center px-3 sm:w-36">
            <Image
              src={modulo}
              alt={producto.imagen.alt}
              widths={[160, 320]}
              sizes="128px"
              loading="lazy"
              format="webp"
              quality={80}
              class="relative z-10 h-24 w-auto max-w-full object-contain"
            />
          </div>

          <div class="min-w-0 flex-1">
            <h3 class="font-display text-[1.1rem] font-bold text-negro">
              {producto.nombre}
            </h3>
            {copy !== undefined && (
              <p class="mt-1 text-[0.9rem] text-grafito/85">{copy.resumen}</p>
            )}

            <p class="mt-4 text-xs font-semibold tracking-[0.12em] text-gris uppercase">
              {precio.etiquetaPresentaciones}
            </p>

            <ul class="mt-2 flex flex-wrap gap-2">
              {producto.presentaciones.map((presentacion) => (
                <li>
                  <a
                    href={buildWhatsAppUrl(
                      {
                        tipo: 'presupuesto',
                        producto: producto.nombre,
                        presentacion: presentacion.etiqueta,
                      },
                      locale,
                    )}
                    {...ATRIBUTOS_ENLACE_EXTERNO}
                    class="inline-flex items-center gap-1.5 rounded-chip border border-gris-claro bg-hueso px-3 py-1.5 text-sm font-medium tabular-nums text-grafito transition-colors hover:border-verde-oscuro hover:bg-verde-suave hover:text-verde-profundo"
                    aria-label={`${precio.ctaVariante}: ${producto.nombre}, ${presentacion.etiqueta}`}
                  >
                    {presentacion.etiqueta}
                    {mostrarPrecios && formatearPrecio(presentacion.precio) !== undefined && (
                      <span class="font-semibold text-negro">
                        {formatearPrecio(presentacion.precio)}
                      </span>
                    )}
                    <Icon name="simple-icons:whatsapp" class="size-3.5" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>

            {!mostrarPrecios && (
              <p class="mt-3 text-[0.82rem] text-gris">
                {config.precios.leyendaSinPrecio}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <div
    class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
    data-revelar
  >
    <p class="flex items-start gap-2 text-[0.9rem] text-grafito/85">
      <Icon name="lucide:truck" class="mt-0.5 size-5 shrink-0 text-verde-oscuro" aria-hidden="true" />
      {precio.nota}
    </p>
    <a
      href="#presupuesto"
      class="inline-flex shrink-0 items-center gap-1.5 text-[0.9rem] font-semibold text-verde-oscuro hover:text-verde-profundo"
    >
      {contenido.presupuesto.titulo}
      <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
    </a>
  </div>
</Section>
