---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import Button from '../ui/Button.astro';
import logoMarca from '../../assets/images/marca/logo-3s-metalico-transparente.png';
import { config, obtenerContenido, rutaLocal } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const { hero } = obtenerContenido(locale);
---

<section
  class="hero-marca relative isolate overflow-hidden bg-carbon text-white"
  aria-labelledby="hero-titulo"
>
  <div
    class="trama-carbon pointer-events-none absolute inset-0 opacity-40 lg:opacity-100"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-48 left-1/2 aspect-square w-[46rem] -translate-x-1/2 rounded-full bg-verde/14 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute top-28 left-1/2 hidden size-[42rem] -translate-x-1/2 rotate-45 border border-verde/12 lg:block"
    aria-hidden="true"
  >
  </div>

  <div class="contenedor relative flex min-h-[calc(100svh-4.5rem)] flex-col items-center justify-center pt-28 pb-14 text-center sm:pt-32 sm:pb-16 lg:pt-36 lg:pb-20">
    <div class="marca-portada w-full max-w-[58rem]" data-revelar>
      <Image
        src={logoMarca}
        alt="3S Grupo Industrial S.R.L."
        widths={[480, 960, 1565]}
        sizes="(min-width: 1024px) 54rem, (min-width: 640px) 82vw, 94vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={96}
        class="mx-auto w-full drop-shadow-[0_24px_32px_rgb(0_0_0/0.5)]"
      />
    </div>

    <div class="mt-9 max-w-[54rem] sm:mt-11" data-revelar data-revelar-retraso="100">
      <h1
        id="hero-titulo"
        class="text-[clamp(2rem,1.3rem+2.4vw,3.5rem)] leading-[1.08] font-black tracking-[-0.025em] text-white"
      >
        {hero.titular}
      </h1>

      <p class="mx-auto mt-5 max-w-[46rem] text-base leading-relaxed text-white/72 sm:text-lg">
        {hero.subtitulo}
      </p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <Button href={rutaLocal('/#presupuesto', locale)} tamano="grande">
          {hero.ctaPrimario}
          <Icon name="lucide:mail" class="size-5" aria-hidden="true" />
        </Button>

        <Button
          href={rutaLocal('/productos', locale)}
          variante="fantasma"
          tamano="grande"
        >
          {hero.ctaSecundario}
          <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-white/[0.03]">
    <ul
      class="contenedor grid divide-y divide-white/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      data-revelar
      data-revelar-retraso="180"
    >
      {
        hero.senales.map((senal) => (
          <li class="flex gap-3.5 py-5 text-left sm:px-6 sm:py-7 sm:first:pl-0 sm:last:pr-0">
            <Icon
              name={`lucide:${senal.icono}`}
              class="mt-0.5 size-6 shrink-0 text-verde"
              aria-hidden="true"
            />
            <div>
              <p class="font-display text-[0.95rem] font-bold text-white">{senal.titulo}</p>
              <p class="mt-1 text-sm text-white/60">{senal.detalle}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marca-portada {
    animation: entrada-marca 720ms var(--ease-salida) both;
  }

  @keyframes entrada-marca {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.975);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marca-portada {
      animation: none;
    }
  }
</style>
