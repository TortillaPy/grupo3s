---
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import WhatsAppLink from '../ui/WhatsAppLink.astro';
import { config, obtenerContenido } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const contenido = obtenerContenido(locale);
const { faq, hero, presupuesto } = contenido;
---

<Section id="faq" titulo={faq.titulo} bajada={faq.bajada} fondo="blanco">
  <!--
    Dos columnas desde `lg`. Antes el acordeón ocupaba el ancho de
    lectura y dejaba media pantalla vacía a la derecha; ahora esa mitad
    la ocupa una tarjeta de contacto, que es exactamente lo que busca
    alguien cuya pregunta no está en la lista.
  -->
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <!--
        Acordeón sobre <details>/<summary>: el navegador ya expone el
        estado abierto/cerrado a los lectores de pantalla y lo opera con
        Enter y con la barra espaciadora. No hace falta una sola línea
        de JavaScript, y con JS desactivado sigue funcionando igual.

        Cada pregunta es una tarjeta: al abrirse se tiñe de verde suave,
        que es la forma más barata de que se vea cuál está abierta sin
        depender solo de la flecha.
      -->
      <ul class="flex flex-col gap-3">
        {
          faq.items.map((item) => (
            <li data-revelar>
              <details class="tarjeta group overflow-hidden transition-colors duration-200 open:border-verde/40 open:bg-verde-suave/35">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-left font-display text-[1.02rem] font-bold text-negro transition-colors hover:text-verde-profundo sm:px-6 [&::-webkit-details-marker]:hidden">
                  {item.pregunta}
                  <span
                    class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-verde-suave text-verde-profundo transition-transform duration-200 group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <Icon name="lucide:chevron-down" class="size-4" />
                  </span>
                </summary>
                <p class="max-w-lectura px-5 pb-5 text-grafito/90 sm:px-6">
                  {item.respuesta}
                </p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-5">
      <!--
        `sticky` para que la tarjeta acompañe la lectura del acordeón en
        pantallas altas. El `top` deja libre el alto del header sticky.
      -->
      <div class="tarjeta bg-hueso p-6 sm:p-7 lg:sticky lg:top-24" data-revelar>
        <span
          class="inline-flex size-12 items-center justify-center rounded-chip bg-verde-suave text-verde-profundo"
          aria-hidden="true"
        >
          <Icon name="lucide:headset" class="size-6" />
        </span>

        <p class="mt-5 font-display text-[1.15rem] font-bold text-negro">
          {presupuesto.titulo}
        </p>
        <p class="mt-2 text-[0.95rem] text-grafito/85">
          {presupuesto.bajada}
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <WhatsAppLink contexto={{ tipo: 'general' }} locale={locale} class="w-full">
            <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
            {hero.ctaPrimario}
          </WhatsAppLink>

          <a
            href={`tel:+${config.contacto.telefonos[0]?.e164 ?? config.contacto.whatsapp.e164}`}
            class="inline-flex items-center justify-center gap-2 rounded-chip border border-negro/15 bg-blanco px-5 py-3 text-[0.95rem] font-semibold text-negro shadow-nivel-1 transition-colors hover:border-negro/30 hover:bg-hueso"
          >
            <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
            {config.contacto.telefonos[0]?.visible ?? config.contacto.whatsapp.visible}
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>
