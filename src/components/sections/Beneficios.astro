---
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import { config, obtenerContenido } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const { beneficios } = obtenerContenido(locale);
---

<Section
  id="beneficios"
  volanta={beneficios.volanta}
  titulo={beneficios.titulo}
  bajada={beneficios.bajada}
  fondo="hueso"
>
  <!--
    Tarjetas separadas, no celdas de una grilla continua. El ícono va
    dentro de una placa verde suave: es lo que le da a cada tarjeta un
    punto de entrada para la vista, y de paso hace que el verde de
    marca aparezca seis veces sin saturar la sección.
  -->
  <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
    {
      beneficios.items.map((beneficio, indice) => (
        <li
          class="tarjeta tarjeta-viva flex flex-col p-6 sm:p-7"
          data-revelar
          data-revelar-retraso={String((indice % 3) * 90)}
        >
          <span
            class="inline-flex size-12 shrink-0 items-center justify-center rounded-chip bg-verde-suave text-verde-profundo"
            aria-hidden="true"
          >
            <Icon name={`lucide:${beneficio.icono}`} class="size-6" />
          </span>
          <h3 class="mt-5 font-display text-[1.05rem] font-bold text-negro">
            {beneficio.titulo}
          </h3>
          <p class="mt-2 text-[0.95rem] text-grafito/85">{beneficio.texto}</p>
        </li>
      ))
    }
  </ul>
</Section>
