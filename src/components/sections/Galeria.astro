---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import Section from '../ui/Section.astro';
import { config, obtenerContenido } from '@data/site';
import type { Locale } from '@data/site';
import { resolverImagen } from '../../lib/imagenes';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const { galeria } = obtenerContenido(locale);

const imagenes = galeria.items.map((item) => ({
  ...item,
  modulo: resolverImagen(item.src),
}));
---

<Section
  id="galeria"
  volanta={galeria.volanta}
  titulo={galeria.titulo}
  bajada={galeria.bajada}
  fondo="blanco"
>
  <!--
    Mosaico asimétrico en vez de una grilla pareja: una grilla de seis
    rectángulos iguales no le dice a nadie qué mirar primero. Las seis
    imágenes llenan la grilla exacta en los dos tamaños: en móvil, dos
    columnas por tres filas; desde `lg`, tres columnas donde la primera
    ocupa un cuadrado de 2×2 y las otras cinco completan el rectángulo
    sin dejar un hueco.
  -->
  <ul class="grid auto-rows-[9rem] grid-cols-2 gap-3 sm:auto-rows-[12rem] sm:gap-4 lg:grid-cols-3">
    {
      imagenes.map((imagen, indice) => (
        <li
          class:list={[
            'min-w-0',
            /* Solo la primera se agranda, y solo desde tres columnas. */
            indice === 0 && 'lg:col-span-2 lg:row-span-2',
          ]}
          data-revelar
          data-revelar-retraso={String((indice % 3) * 90)}
        >
          <button
            type="button"
            class="group relative block size-full cursor-zoom-in overflow-hidden rounded-card border border-gris-claro/70 bg-hueso shadow-nivel-1 transition-shadow duration-200 hover:shadow-nivel-2"
            data-abrir-galeria
            data-indice={String(indice)}
            aria-label={`${imagen.alt} — ${galeria.titulo}, ${indice + 1} ${galeria.de} ${imagenes.length}`}
          >
            <Image
              src={imagen.modulo}
              alt={imagen.alt}
              widths={[300, 600, 900]}
              sizes={
                indice === 0
                  ? '(min-width: 1024px) 31rem, 45vw'
                  : '(min-width: 1024px) 15rem, 45vw'
              }
              loading="lazy"
              format="webp"
              quality={78}
              class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            />
            {/*
              Velo que aparece al pasar el puntero, con el ícono de lupa.
              Es la señal de que la imagen se abre; sin él, que la foto
              sea clicable hay que adivinarlo.
            */}
            <span
              class="absolute inset-0 flex items-end justify-end bg-linear-to-t from-negro/55 to-transparent p-3 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 dark:from-[#0b060c]/55"
              aria-hidden="true"
            >
              {/* Insignia fija, blanco con ícono oscuro: va sobre la
                  foto, no sobre la página, así que no sigue el tema. */}
              <span class="grid size-9 place-items-center rounded-full bg-white/90 text-negro dark:text-[#0b060c]">
                <Icon name="lucide:maximize-2" class="size-4" />
              </span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</Section>

<!--
  Lightbox sobre <dialog> nativo: el navegador se encarga solo de atrapar
  el foco mientras está abierto, de cerrarlo con Escape y de devolver el
  foco al botón que lo abrió. Reimplementar eso a mano es la forma más
  común de romper la accesibilidad de una galería.
-->
<dialog
  id="galeria-lightbox"
  class="fixed inset-0 m-auto max-h-none max-w-none border-0 bg-negro/96 p-0 backdrop:bg-negro/80 dark:bg-[#0b060c]/96 dark:backdrop:bg-[#0b060c]/80"
  aria-label={galeria.titulo}
  data-lightbox
>
  <div class="flex h-dvh w-dvw flex-col">
    <div class="flex shrink-0 items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <p
        class="text-sm tabular-nums text-white/70"
        aria-live="polite"
        data-contador
        data-separador={galeria.de}
      >
        1 {galeria.de} {imagenes.length}
      </p>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-chip text-white transition-colors hover:bg-white/15"
        aria-label={galeria.cerrar}
        data-cerrar-galeria
      >
        <Icon name="lucide:x" class="size-6" aria-hidden="true" />
      </button>
    </div>

    <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16" data-fondo>
      <button
        type="button"
        class="absolute left-1 z-10 inline-flex size-12 items-center justify-center rounded-full bg-negro/55 text-white transition-colors hover:bg-negro/80 sm:left-3 dark:bg-[#0b060c]/55 dark:hover:bg-[#0b060c]/80"
        aria-label={galeria.anterior}
        data-anterior
      >
        <Icon name="lucide:chevron-left" class="size-7" aria-hidden="true" />
      </button>

      {
        imagenes.map((imagen, indice) => (
          <div
            class:list={[
              'flex max-h-full items-center justify-center',
              indice !== 0 && 'hidden',
            ]}
            data-diapositiva
            data-fondo
            data-indice={String(indice)}
            data-epigrafe-texto={imagen.epigrafe}
          >
            <Image
              src={imagen.modulo}
              alt={imagen.alt}
              widths={[600, 1000]}
              sizes="90vw"
              loading="lazy"
              format="webp"
              quality={82}
              class="max-h-full w-auto max-w-full object-contain"
            />
          </div>
        ))
      }

      <button
        type="button"
        class="absolute right-1 z-10 inline-flex size-12 items-center justify-center rounded-full bg-negro/55 text-white transition-colors hover:bg-negro/80 sm:right-3 dark:bg-[#0b060c]/55 dark:hover:bg-[#0b060c]/80"
        aria-label={galeria.siguiente}
        data-siguiente
      >
        <Icon name="lucide:chevron-right" class="size-7" aria-hidden="true" />
      </button>
    </div>

    <p
      class="shrink-0 px-4 py-4 text-center text-sm text-white/85 sm:px-6 sm:text-[0.95rem]"
      data-epigrafe
    >
      {imagenes[0]?.epigrafe ?? ''}
    </p>
  </div>
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dialogo !== null) {
    const diapositivas = Array.from(
      dialogo.querySelectorAll<HTMLElement>('[data-diapositiva]'),
    );
    const contador = dialogo.querySelector<HTMLElement>('[data-contador]');
    const epigrafe = dialogo.querySelector<HTMLElement>('[data-epigrafe]');
    const separador = contador?.dataset.separador ?? 'de';
    const total = diapositivas.length;
    let actual = 0;

    const mostrar = (indice: number): void => {
      actual = (indice + total) % total;
      diapositivas.forEach((slide, i) => {
        slide.classList.toggle('hidden', i !== actual);
      });
      if (contador !== null) {
        contador.textContent = `${actual + 1} ${separador} ${total}`;
      }
      if (epigrafe !== null) {
        epigrafe.textContent = diapositivas[actual]?.dataset.epigrafeTexto ?? '';
      }
    };

    document
      .querySelectorAll<HTMLElement>('[data-abrir-galeria]')
      .forEach((boton) => {
        boton.addEventListener('click', () => {
          mostrar(Number(boton.dataset.indice ?? '0'));
          dialogo.showModal();
        });
      });

    dialogo
      .querySelector('[data-cerrar-galeria]')
      ?.addEventListener('click', () => dialogo.close());
    dialogo
      .querySelector('[data-anterior]')
      ?.addEventListener('click', () => mostrar(actual - 1));
    dialogo
      .querySelector('[data-siguiente]')
      ?.addEventListener('click', () => mostrar(actual + 1));

    // El <dialog> ocupa toda la pantalla, así que el clic "afuera" de la
    // foto cae en las zonas marcadas con data-fondo, no en el dialog.
    dialogo.addEventListener('click', (evento) => {
      const objetivo = evento.target;
      if (!(objetivo instanceof HTMLElement)) return;
      if (objetivo === dialogo || objetivo.hasAttribute('data-fondo')) {
        dialogo.close();
      }
    });

    dialogo.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowLeft') {
        evento.preventDefault();
        mostrar(actual - 1);
      } else if (evento.key === 'ArrowRight') {
        evento.preventDefault();
        mostrar(actual + 1);
      }
    });
  }
</script>
