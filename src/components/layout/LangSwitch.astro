---
import { config, localesDisponibles, rutaLocal } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
  readonly class?: string;
}

const { locale = config.localePorDefecto, class: claseExtra = '' } = Astro.props;

/** Cómo se nombra cada idioma: siempre en su propio idioma. */
const NOMBRES: Readonly<Record<Locale, { corto: string; largo: string }>> = {
  es: { corto: 'ES', largo: 'Español' },
  pt: { corto: 'PT', largo: 'Português' },
  en: { corto: 'EN', largo: 'English' },
};

/**
 * Ruta actual sin el prefijo de idioma, para poder reconstruirla en
 * cualquier otro. Así el cambio de idioma deja al visitante en la misma
 * página, no en la portada.
 */
function rutaBase(pathname: string): string {
  const limpia = pathname.replace(/\/+$/, '') || '/';
  for (const disponible of localesDisponibles) {
    if (disponible === config.localePorDefecto) continue;
    if (limpia === `/${disponible}`) return '/';
    if (limpia.startsWith(`/${disponible}/`)) {
      return limpia.slice(disponible.length + 1);
    }
  }
  return limpia;
}

const base = rutaBase(Astro.url.pathname);
---

{
  localesDisponibles.length > 1 && (
    <nav aria-label="Idioma / Language" class={claseExtra}>
      <ul class="flex items-center gap-1">
        {localesDisponibles.map((disponible) => {
          const activo = disponible === locale;
          /*
            Los colores no van como clases fijas sino en el <style> de
            abajo: el mismo componente tiene que leerse igual de bien
            en el header claro y flotando sobre el panel oscuro del
            hero, y el estado lo decide una clase del <header>.
          */
          return (
            <li>
              <a
                href={rutaLocal(base, disponible)}
                hreflang={disponible}
                lang={disponible}
                aria-current={activo ? 'true' : undefined}
                class:list={[
                  'idioma inline-flex min-w-9 items-center justify-center rounded-chip px-1.5 py-1.5 text-[0.78rem] font-semibold transition-colors',
                  activo && 'idioma-activo',
                ]}
              >
                <span aria-hidden="true">{NOMBRES[disponible].corto}</span>
                <span class="sr-only">{NOMBRES[disponible].largo}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  /*
    Estado por defecto: header claro o menú móvil. El idioma activo se
    marca con fondo, no con color, para que se distinga sin depender de
    que alguien perciba la diferencia de tono.
  */
  .idioma {
    color: color-mix(in oklab, var(--color-grafito) 82%, transparent);
  }

  .idioma:hover {
    background-color: color-mix(in oklab, var(--color-negro) 5%, transparent);
    color: var(--color-negro);
  }

  .idioma-activo {
    background-color: color-mix(in oklab, var(--color-negro) 8%, transparent);
    color: var(--color-negro);
  }

  /* Sobre el panel oscuro del hero, mientras el header sigue flotando. */
  :global(.cabecera-sobre-oscuro:not(.cabecera-solida)) .idioma {
    color: color-mix(in oklab, var(--color-blanco) 70%, transparent);
  }

  :global(.cabecera-sobre-oscuro:not(.cabecera-solida)) .idioma:hover {
    background-color: color-mix(in oklab, var(--color-blanco) 12%, transparent);
    color: var(--color-blanco);
  }

  :global(.cabecera-sobre-oscuro:not(.cabecera-solida)) .idioma-activo {
    background-color: color-mix(in oklab, var(--color-blanco) 16%, transparent);
    color: var(--color-blanco);
  }
</style>
