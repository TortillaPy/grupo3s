---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import Button from '../ui/Button.astro';
import AlternadorTema from '../ui/AlternadorTema.astro';
import LangSwitch from './LangSwitch.astro';
import { config, obtenerContenido, rutaLocal } from '@data/site';
import type { Locale } from '@data/site';
import { resolverImagen } from '../../lib/imagenes';

interface Props {
  readonly locale?: Locale;
  /**
   * `true` cuando la página arranca con el panel oscuro del hero. El
   * header nace transparente y con texto claro, y recién al scrollear
   * pasa a fondo claro. En las páginas que arrancan en claro
   * —catálogo, ficha, gracias— va en `false` y el header es claro
   * desde el primer píxel.
   */
  readonly sobreOscuro?: boolean;
}

const { locale = config.localePorDefecto, sobreOscuro = false } = Astro.props;
const { nav } = obtenerContenido(locale);

/*
  Dos versiones del logotipo, ambas con el fondo recortado. La original
  del catálogo venía sobre un rectángulo blanco opaco: sobre el carbón
  del hero se veía el recuadro, no la marca.
  - `logo-3s-transparente`: tinta original, para fondo claro.
  - `logo-3s-blanco`: la misma pieza con la tinta en blanco y la hoja en
    el verde del isotipo, para los paneles oscuros.
  Cuando llegue el logotipo vectorial del cliente, se reemplazan estos
  dos archivos y no hay que tocar nada más.
*/
const logoClaro = resolverImagen('/src/assets/images/marca/logo-3s-transparente.png');
const logoOscuro = resolverImagen('/src/assets/images/marca/logo-3s-blanco.png');
---

<header
  id="cabecera"
  class:list={[
    'fixed inset-x-0 top-0 z-50 border-b border-transparent text-grafito',
    'transition-[background-color,border-color,box-shadow,color] duration-200',
    sobreOscuro && 'cabecera-sobre-oscuro',
  ]}
  data-cabecera
  data-sobre-oscuro={sobreOscuro ? 'si' : 'no'}
>
  <div class="contenedor flex h-18 items-center justify-between gap-4">
    <a
      href={rutaLocal('/', locale)}
      class="flex shrink-0 items-center"
      aria-label={`${config.site.nombre}, ${nav.irAlInicio}`}
    >
      {/*
        Las dos versiones se emiten siempre y se alternan por CSS con
        una clase en el <header> (y, en modo oscuro, con la clase
        `dark` de <html>). Hacerlo así —en vez de cambiar el src por
        JS— evita que el logotipo parpadee al scrollear o al cambiar
        de tema, y mantiene el alto reservado: cero desplazamiento de
        layout.
      */}
      {/*
        Solo la variante visible al cargar va `eager`; la otra se pide
        en diferido. Ninguna es LCP: en la portada lo es el logo central.
      */}
      <Image
        src={logoClaro}
        alt=""
        widths={[140, 280]}
        sizes="88px"
        loading={sobreOscuro ? 'lazy' : 'eager'}
        format="webp"
        quality={90}
        class:list={['h-13 w-auto', sobreOscuro && 'hidden']}
        data-logo-claro
      />
      <Image
        src={logoOscuro}
        alt=""
        widths={[140, 280]}
        sizes="88px"
        loading={sobreOscuro ? 'eager' : 'lazy'}
        format="webp"
        quality={90}
        class:list={['h-13 w-auto', !sobreOscuro && 'hidden']}
        data-logo-oscuro
      />
    </a>

    <!-- Navegación de escritorio -->
    <nav class="hidden lg:block" aria-label={nav.navegacionPrincipal}>
      <ul class="flex items-center gap-7">
        {
          nav.enlaces.map((enlace) => (
            <li>
              {/*
                El color se hereda del <header> vía `currentColor`:
                blanco mientras flota sobre el hero, grafito en cuanto
                se vuelve sólido. Ni una clase condicional acá.
              */}
              <a
                href={rutaLocal(enlace.href, locale)}
                class="enlace-nav rounded-chip text-[0.92rem] font-medium transition-colors"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitch locale={locale} class="hidden md:block" />
      <AlternadorTema
        etiquetaOscuro={nav.activarModoOscuro}
        etiquetaClaro={nav.activarModoClaro}
        class="hidden sm:inline-flex"
      />

      <div class="hidden sm:block">
        {/* Lleva al formulario de "Solicitá tu presupuesto" en la
            portada, no a WhatsApp: es la vía preferida para pedidos
            con detalle (producto, volumen, dirección de entrega). */}
        <Button href={rutaLocal('/#presupuesto', locale)}>
          {nav.cta}
        </Button>
      </div>

      <button
        type="button"
        id="alternar-menu"
        class="boton-menu inline-flex size-11 items-center justify-center rounded-chip border transition-colors lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label={nav.abrirMenu}
        data-abrir={nav.abrirMenu}
        data-cerrar={nav.cerrarMenu}
      >
        <Icon name="lucide:menu" class="size-6" data-icono-menu aria-hidden="true" />
        <Icon name="lucide:x" class="hidden size-6" data-icono-cerrar aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div
    id="menu-movil"
    class="hidden border-t border-gris-claro bg-blanco text-grafito shadow-nivel-2 lg:hidden"
    data-menu-movil
  >
    <nav class="contenedor py-4" aria-label={nav.navegacionMovil}>
      <ul class="flex flex-col">
        {
          nav.enlaces.map((enlace) => (
            <li class="border-b border-gris-claro last:border-b-0">
              <a
                href={rutaLocal(enlace.href, locale)}
                class="block py-3.5 font-medium text-grafito transition-colors hover:text-verde-oscuro"
                data-enlace-movil
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <LangSwitch locale={locale} class="mt-4 md:hidden" />
      <AlternadorTema
        etiquetaOscuro={nav.activarModoOscuro}
        etiquetaClaro={nav.activarModoClaro}
        class="mt-4 inline-flex sm:hidden"
      />

      <div class="mt-4 sm:hidden">
        {/* Lleva al formulario de "Solicitá tu presupuesto" en la
            portada, no a WhatsApp: es la vía preferida para pedidos
            con detalle (producto, volumen, dirección de entrega). */}
        <Button href={rutaLocal('/#presupuesto', locale)} tamano="grande" class="w-full">
          {nav.cta}
        </Button>
      </div>
    </nav>
  </div>
</header>

{/*
  Reserva del alto del header. Solo hace falta en las páginas de fondo
  claro: ahí el header es opaco y empujaría el contenido. Sobre el hero
  oscuro el header flota por encima del panel a propósito, y el espacio
  lo pone el propio hero con su padding superior.
*/}
{!sobreOscuro && <div class="h-18" aria-hidden="true" />}

<script>
  const cabecera = document.querySelector<HTMLElement>('[data-cabecera]');
  const boton = document.querySelector<HTMLButtonElement>('#alternar-menu');
  const menu = document.querySelector<HTMLElement>('[data-menu-movil]');
  const iconoMenu = document.querySelector<HTMLElement>('[data-icono-menu]');
  const iconoCerrar = document.querySelector<HTMLElement>('[data-icono-cerrar]');

  /* ── Fondo translúcido con blur al scrollear ──────────────────────── */
  if (cabecera !== null) {
    /*
      `bg-hueso/92` y no `/85`: con más transparencia el desenfoque
      arrastra manchas de color del contenido que pasa por debajo —las
      tarjetas de producto, las etiquetas verdes— y el header se ve
      sucio. A 92 % el desenfoque sigue notándose como profundidad pero
      el fondo se lee parejo.
    */
    const CLASES_SCROLL = [
      'cabecera-solida',
      'bg-hueso/92',
      'backdrop-blur-md',
      'backdrop-saturate-50',
      'border-gris-claro',
      'shadow-[0_1px_16px_-8px_rgba(11,6,12,0.45)]',
    ];

    /*
      El umbral es de 8 px en las páginas claras, pero en las que
      arrancan con el hero oscuro conviene esperar un poco más: si el
      header se vuelve claro apenas el usuario roza la rueda, el cambio
      se lee como un parpadeo. 64 px es la distancia a la que ya se
      entiende que hubo scroll.
    */
    const umbral = cabecera.dataset.sobreOscuro === 'si' ? 64 : 8;

    const actualizarCabecera = (): void => {
      const activa = window.scrollY > umbral;
      CLASES_SCROLL.forEach((clase) => cabecera.classList.toggle(clase, activa));
      cabecera.classList.toggle('border-transparent', !activa);
    };

    actualizarCabecera();
    window.addEventListener('scroll', actualizarCabecera, { passive: true });
  }

  /* ── Menú hamburguesa ─────────────────────────────────────────────── */
  if (boton !== null && menu !== null) {
    const abrirEtiqueta = boton.dataset.abrir ?? 'Abrir el menú';
    const cerrarEtiqueta = boton.dataset.cerrar ?? 'Cerrar el menú';

    const alternar = (abierto: boolean): void => {
      boton.setAttribute('aria-expanded', String(abierto));
      boton.setAttribute('aria-label', abierto ? cerrarEtiqueta : abrirEtiqueta);
      menu.classList.toggle('hidden', !abierto);
      iconoMenu?.classList.toggle('hidden', abierto);
      iconoCerrar?.classList.toggle('hidden', !abierto);
    };

    boton.addEventListener('click', () => {
      alternar(boton.getAttribute('aria-expanded') !== 'true');
    });

    // Al elegir cualquier destino, incluido idioma y CTA, el menú se cierra solo.
    menu.querySelectorAll('a').forEach((enlace) => {
      enlace.addEventListener('click', () => alternar(false));
    });

    // Escape cierra y devuelve el foco al botón.
    document.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Escape') return;
      if (boton.getAttribute('aria-expanded') !== 'true') return;
      alternar(false);
      boton.focus();
    });

    // Volver a escritorio con el menú abierto lo deja en un estado raro.
    const consultaEscritorio = window.matchMedia('(min-width: 1024px)');
    consultaEscritorio.addEventListener('change', (evento) => {
      if (evento.matches) alternar(false);
    });
  }
</script>

<style>
  /*
    Los dos estados del header. La regla es una sola: sobre el panel
    oscuro del hero el header es transparente y de tinta clara; en
    cuanto entra `.cabecera-solida` —o si la página no arranca en
    oscuro— vuelve al esquema claro. Todo lo demás hereda de
    `currentColor`, así que no hay clases condicionales repartidas por
    el marcado.
  */

  .enlace-nav {
    padding-block: 0.25rem;
  }

  .enlace-nav:hover {
    color: var(--color-verde-oscuro);
  }

  .boton-menu {
    border-color: color-mix(in oklab, var(--color-negro) 15%, transparent);
  }

  .boton-menu:hover {
    border-color: color-mix(in oklab, var(--color-negro) 40%, transparent);
  }

  /*
    ── Estado “sobre el hero oscuro”, antes de scrollear ─────────────
    El hero es carbón fijo en los dos temas (ver Hero.astro), así que
    acá se usa blanco literal y no el token --color-blanco: ese token
    se oscurece en modo oscuro para servir de fondo de tarjeta, y un
    "blanco" oscuro dejaría el texto invisible sobre el hero.
  */

  .cabecera-sobre-oscuro:not(.cabecera-solida) {
    color: #ffffff;
  }

  /* El verde oscuro no se lee sobre carbón; ahí el hover va al verde
     del isotipo, que da 6,4:1 contra el fondo del hero. */
  .cabecera-sobre-oscuro:not(.cabecera-solida) .enlace-nav:hover {
    color: var(--color-verde);
  }

  .cabecera-sobre-oscuro:not(.cabecera-solida) .boton-menu {
    border-color: color-mix(in oklab, #ffffff 30%, transparent);
  }

  .cabecera-sobre-oscuro:not(.cabecera-solida) .boton-menu:hover {
    border-color: color-mix(in oklab, #ffffff 60%, transparent);
    background-color: color-mix(in oklab, #ffffff 10%, transparent);
  }

  /*
    Al volverse sólido el header, el logotipo claro reemplaza al
    blanco. Se alternan por display para que no haya reflow. Solo en
    modo claro: ahí el header sólido es hueso claro. En modo oscuro
    `bg-hueso/92` es oscuro incluso "sólido", así que el logotipo
    blanco queda fijo sin importar el scroll (regla siguiente).
  */
  :global(html:not(.dark)) .cabecera-sobre-oscuro.cabecera-solida [data-logo-oscuro] {
    display: none;
  }

  :global(html:not(.dark)) .cabecera-sobre-oscuro.cabecera-solida [data-logo-claro] {
    display: block;
  }

  /*
    Modo oscuro: la página entera es oscura, así que el header nunca
    vuelve a ser una superficie clara. El logotipo blanco queda fijo
    sin importar si la página arranca sobre el hero o no.
  */
  :global(.dark) [data-logo-claro] {
    display: none;
  }

  :global(.dark) [data-logo-oscuro] {
    display: block;
  }
</style>
