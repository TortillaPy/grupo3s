---
import { ATRIBUTOS_ENLACE_EXTERNO } from '@data/site';

type Variante = 'primario' | 'secundario' | 'claro' | 'fantasma';
type Tamano = 'normal' | 'grande';

interface Props {
  readonly variante?: Variante;
  readonly tamano?: Tamano;
  /** Si viene, se renderiza un <a>; si no, un <button>. */
  readonly href?: string;
  /** Agrega target y rel de enlace externo. */
  readonly externo?: boolean;
  readonly type?: 'button' | 'submit';
  readonly disabled?: boolean;
  readonly id?: string;
  readonly ariaLabel?: string;
  readonly class?: string;
}

const {
  variante = 'primario',
  tamano = 'normal',
  href,
  externo = false,
  type = 'button',
  disabled = false,
  id,
  ariaLabel,
  class: claseExtra = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-chip font-semibold ' +
  'transition-[background-color,border-color,color,box-shadow,transform] duration-150 ' +
  'disabled:cursor-not-allowed disabled:opacity-60 text-center leading-tight ' +
  'active:translate-y-px motion-reduce:active:translate-y-0';

const porTamano: Record<Tamano, string> = {
  normal: 'px-5 py-3 text-[0.95rem]',
  grande: 'px-6 py-3.5 text-base sm:px-7 sm:py-4',
};

const porVariante: Record<Variante, string> = {
  // Verde profundo: 7.4:1 con texto blanco. El verde del isotipo no alcanza.
  // La sombra teñida de verde le da peso de botón principal sin subirle
  // la saturación al color. El "dark:bg-" fija el verde de modo claro:
  // en modo oscuro el token --color-verde-oscuro se aclara para servir
  // de texto/borde, y ese verde claro no da 4.5:1 con texto blanco.
  primario:
    'bg-verde-oscuro text-white shadow-[0_1px_2px_-1px_rgb(30_90_34/0.4),0_10px_24px_-10px_rgb(30_90_34/0.55)] ' +
    'hover:bg-verde-profundo hover:shadow-[0_2px_4px_-2px_rgb(30_90_34/0.45),0_16px_32px_-12px_rgb(30_90_34/0.65)] ' +
    'dark:bg-[#2c7d31] dark:hover:bg-[#1e5a22]',
  secundario:
    'border border-negro/15 bg-blanco text-negro shadow-nivel-1 hover:border-negro/30 hover:bg-hueso',
  claro: 'bg-blanco text-negro shadow-nivel-1 hover:bg-hueso',
  // Para los paneles oscuros: contorno claro sobre carbón, sin relleno.
  fantasma:
    'border border-white/25 bg-white/5 text-white backdrop-blur-sm hover:border-white/50 hover:bg-white/12',
};

const clases = [base, porTamano[tamano], porVariante[variante], claseExtra]
  .filter(Boolean)
  .join(' ');

const atributosExternos = externo ? ATRIBUTOS_ENLACE_EXTERNO : {};
---

{
  href !== undefined ? (
    <a href={href} class={clases} id={id} aria-label={ariaLabel} {...atributosExternos}>
      <slot />
    </a>
  ) : (
    <button type={type} class={clases} id={id} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  )
}
