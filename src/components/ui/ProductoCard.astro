---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import { obtenerContenido, config, rutaLocal } from '@data/site';
import type { Locale, Producto } from '@data/site';
import { resolverImagen } from '../../lib/imagenes';

interface Props {
  readonly producto: Producto;
  readonly locale?: Locale;
  /** Retraso del fade-in de entrada, en milisegundos. */
  readonly retraso?: number;
  /**
   * Nivel del encabezado de la tarjeta. En el catálogo, donde las
   * tarjetas cuelgan directo del h1 de la página, va 2; dentro de una
   * sección que ya tiene su h2 —"De la misma familia"— va 3. Saltar de
   * h1 a h3 es un error de jerarquía que los lectores de pantalla
   * anuncian mal.
   */
  readonly nivel?: 2 | 3;
}

const {
  producto,
  locale = config.localePorDefecto,
  retraso = 0,
  nivel = 3,
} = Astro.props;

const Encabezado = `h${nivel}` as 'h2' | 'h3';

const contenido = obtenerContenido(locale);
const copy = contenido.productos[producto.slug];
const categoria = contenido.categorias.find(
  (item) => item.id === producto.categoria,
);
const modulo = resolverImagen(producto.imagen.src);
---

<article
  class="tarjeta tarjeta-viva group relative flex h-full flex-col overflow-hidden"
  data-producto
  data-categoria={producto.categoria}
  data-revelar
  data-revelar-retraso={String(retraso)}
>
  <!--
    Los envases vienen recortados sobre blanco. Apoyados sobre el
    plinto —un degradado tenue con una elipse de sombra debajo— dejan
    de flotar en el vacío y se leen como objetos sobre una superficie.
  -->
  <div class="plinto plinto-sombra flex items-center justify-center rounded-none px-5 py-7">
    <Image
      src={modulo}
      alt={producto.imagen.alt}
      widths={[200, 400]}
      sizes="176px"
      loading="lazy"
      format="webp"
      quality={80}
      class="relative z-10 h-36 w-auto max-w-full object-contain transition-transform duration-300 group-hover:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
  <p class="text-xs font-semibold tracking-[0.12em] text-verde-oscuro uppercase">
    {categoria?.nombre}
  </p>

  <Encabezado class="mt-1.5 font-display text-[1.15rem] font-bold text-negro">
    <!--
      El enlace envuelve solo el nombre, pero se estira sobre toda la
      tarjeta con ::after. Así el área clicable es la tarjeta entera y
      el lector de pantalla igual anuncia un único enlace con el nombre
      del producto, no "leer más" repetido dieciocho veces.
    -->
    <a
      href={rutaLocal(`/productos/${producto.slug}`, locale)}
      class="after:absolute after:inset-0 after:content-['']"
    >
      {producto.nombre}
    </a>
  </Encabezado>

  {
    copy !== undefined && (
      <p class="mt-2 text-[0.92rem] text-grafito/85">{copy.resumen}</p>
    )
  }

  <!--
    Las presentaciones como fichas sueltas y no como una lista separada
    por puntos: es lo primero que mira un comprador industrial, y en
    bloques se cuentan de un vistazo. `mt-auto` las empuja al pie para
    que todas las tarjetas de la fila terminen alineadas.
  -->
  <ul class="mt-auto flex flex-wrap gap-1.5 pt-4" aria-label={contenido.ficha.presentaciones}>
    {
      producto.presentaciones.map((presentacion) => (
        <li class="rounded-chip bg-hueso px-2 py-1 text-[0.78rem] font-medium tabular-nums text-grafito ring-1 ring-gris-claro/80 ring-inset">
          {presentacion.etiqueta}
        </li>
      ))
    }
  </ul>

  <p
    class="mt-4 inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-verde-oscuro"
    aria-hidden="true"
  >
    {contenido.catalogo.verFicha}
    <Icon
      name="lucide:arrow-right"
      class="size-4 transition-transform duration-200 group-hover:translate-x-1"
    />
  </p>
  </div>
</article>
