---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { config, obtenerContenido } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const contenido = obtenerContenido(locale);
const { privacidad } = contenido;
---

<Layout
  titulo={contenido.meta.privacidad.titulo}
  descripcion={contenido.meta.privacidad.descripcion}
  ruta="/politica-privacidad"
  locale={locale}
>
  <Header slot="header" locale={locale} />

  <article class="bg-hueso py-14 sm:py-20">
    <div class="contenedor">
      <header class="max-w-lectura">
        <h1 class="text-titulo font-bold text-negro">{privacidad.titulo}</h1>
        <p class="mt-3 text-sm text-gris">{privacidad.actualizado}</p>
      </header>

      <div class="mt-10 flex max-w-lectura flex-col gap-8">
        {
          privacidad.bloques.map((bloque) => (
            <section>
              <h2 class="font-display text-[1.15rem] font-bold text-negro">
                {bloque.titulo}
              </h2>
              <div class="mt-3 flex flex-col gap-3 text-grafito/90">
                {bloque.parrafos.map((parrafo) => (
                  <p>{parrafo}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </article>

  <Footer slot="footer" locale={locale} />
</Layout>
