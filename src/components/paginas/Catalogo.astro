---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import ProductoCard from '@components/ui/ProductoCard.astro';
import BotonWhatsAppFlotante from '@components/ui/BotonWhatsAppFlotante.astro';
import { config, obtenerContenido, productos, rutaLocal } from '@data/site';
import type { Locale } from '@data/site';

interface Props {
  readonly locale?: Locale;
}

const { locale = config.localePorDefecto } = Astro.props;
const contenido = obtenerContenido(locale);
const { catalogo } = contenido;

/** Solo las familias que efectivamente tienen productos cargados. */
const familias = contenido.familias.filter((familia) =>
  productos.some((producto) => producto.familia === familia.id),
);

/** Solo las etapas que efectivamente tienen productos asociados. */
const etapas = contenido.recorrido.items.filter((etapa) =>
  productos.some((producto) => producto.etapas.includes(etapa.id)),
);

/**
 * ItemList: le dice a Google que esta página es un listado y en qué
 * orden están los elementos. Es el marcado correcto para un catálogo
 * —no `Product`, que va en cada ficha—.
 */
const schemaListado = {
  '@type': 'ItemList',
  '@id': `${config.site.url}${rutaLocal('/productos', locale)}#listado`,
  name: catalogo.titulo,
  numberOfItems: productos.length,
  itemListElement: productos.map((producto, indice) => ({
    '@type': 'ListItem',
    position: indice + 1,
    name: producto.nombre,
    url: `${config.site.url}${rutaLocal(`/productos/${producto.slug}`, locale)}`,
  })),
};

const schemaMigas = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: contenido.ficha.migaInicio,
      item: `${config.site.url}${rutaLocal('/', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: contenido.ficha.migaCatalogo,
      item: `${config.site.url}${rutaLocal('/productos', locale)}`,
    },
  ],
};
---

<Layout
  titulo={contenido.meta.productos.titulo}
  descripcion={contenido.meta.productos.descripcion}
  ruta="/productos"
  locale={locale}
  schemas={[schemaListado, schemaMigas]}
>
  <Header slot="header" locale={locale} />

  <section class="bg-hueso py-14 sm:py-20" aria-labelledby="catalogo-titulo">
    <div class="contenedor">
      <nav aria-label="Ruta de navegación" class="mb-6 text-sm text-grafito/80">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={rutaLocal('/', locale)} class="hover:text-verde-oscuro">{contenido.ficha.migaInicio}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-grafito">{contenido.ficha.migaCatalogo}</li>
        </ol>
      </nav>

      <div class="max-w-lectura">
        <h1 id="catalogo-titulo" class="text-titulo font-bold text-negro">
          {catalogo.titulo}
        </h1>
        <p class="mt-4 text-subtitulo text-grafito/90">{catalogo.bajada}</p>
      </div>

      <!-- Sin JavaScript se mantiene visible la línea completa. -->
      <div class="mt-10 space-y-6" data-filtros>
        <fieldset>
          <legend class="text-xs font-semibold tracking-[0.14em] text-gris uppercase">
            {catalogo.filtrarPor}
          </legend>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="rounded-chip border border-gris-claro bg-blanco px-4 py-2 text-sm font-medium text-grafito transition-colors hover:border-verde-oscuro aria-pressed:border-verde-oscuro aria-pressed:bg-verde-oscuro aria-pressed:text-white dark:aria-pressed:bg-[#2c7d31]" data-filtro-familia data-valor="" aria-pressed="true">
              {catalogo.todos}
            </button>
            {familias.map((familia) => (
              <button type="button" class="rounded-chip border border-gris-claro bg-blanco px-4 py-2 text-sm font-medium text-grafito transition-colors hover:border-verde-oscuro aria-pressed:border-verde-oscuro aria-pressed:bg-verde-oscuro aria-pressed:text-white dark:aria-pressed:bg-[#2c7d31]" data-filtro-familia data-valor={familia.id} aria-pressed="false">
                {familia.nombre}
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-xs font-semibold tracking-[0.14em] text-gris uppercase">
            {catalogo.filtrarPorEtapa}
          </legend>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="rounded-chip border border-gris-claro bg-blanco px-4 py-2 text-sm font-medium text-grafito transition-colors hover:border-verde-oscuro aria-pressed:border-verde-oscuro aria-pressed:bg-verde-oscuro aria-pressed:text-white dark:aria-pressed:bg-[#2c7d31]" data-filtro-etapa data-valor="" aria-pressed="true">
              {catalogo.todos}
            </button>
            {etapas.map((etapa) => (
              <button type="button" class="rounded-chip border border-gris-claro bg-blanco px-4 py-2 text-sm font-medium text-grafito transition-colors hover:border-verde-oscuro aria-pressed:border-verde-oscuro aria-pressed:bg-verde-oscuro aria-pressed:text-white dark:aria-pressed:bg-[#2c7d31]" data-filtro-etapa data-valor={etapa.id} aria-pressed="false">
                {etapa.titulo}
              </button>
            ))}
          </div>
        </fieldset>

        <div class="flex flex-wrap items-center gap-4">
          <p
            class="text-sm text-grafito/80"
            aria-live="polite"
            data-conteo
            data-plural={catalogo.conteo}
            data-singular={catalogo.conteoSingular}
          >
            {catalogo.conteo.replace('{n}', String(productos.length))}
          </p>
          <button
            type="button"
            class="hidden text-sm font-semibold text-verde-oscuro hover:underline"
            data-limpiar-filtros
          >
            {catalogo.limpiarFiltros}
          </button>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          productos.map((producto, indice) => (
            <ProductoCard
              producto={producto}
              locale={locale}
              nivel={2}
              retraso={(indice % 3) * 80}
            />
          ))
        }
      </div>

      <p class="mt-6 hidden text-grafito/80" data-sin-resultados>
        {catalogo.sinResultados}
      </p>
    </div>
  </section>

  <Footer slot="footer" locale={locale} />
  <BotonWhatsAppFlotante slot="footer" locale={locale} />
</Layout>

<script>
  const contenedorFiltros = document.querySelector<HTMLElement>('[data-filtros]');
  const tarjetas = Array.from(
    document.querySelectorAll<HTMLElement>('[data-producto]'),
  );
  const conteo = document.querySelector<HTMLElement>('[data-conteo]');
  const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]');
  const limpiar = document.querySelector<HTMLButtonElement>('[data-limpiar-filtros]');

  if (contenedorFiltros !== null && tarjetas.length > 0) {
    const botonesFamilia = Array.from(
      contenedorFiltros.querySelectorAll<HTMLButtonElement>('[data-filtro-familia]'),
    );
    const botonesEtapa = Array.from(
      contenedorFiltros.querySelectorAll<HTMLButtonElement>('[data-filtro-etapa]'),
    );

    const plural = conteo?.dataset.plural ?? '{n} productos';
    const singular = conteo?.dataset.singular ?? '1 producto';
    const familiasValidas = new Set(botonesFamilia.map((boton) => boton.dataset.valor ?? ''));
    const etapasValidas = new Set(botonesEtapa.map((boton) => boton.dataset.valor ?? ''));

    let familiaActiva = '';
    let etapaActiva = '';

    const aplicar = (actualizarUrl = true): void => {
      let visibles = 0;

      tarjetas.forEach((tarjeta) => {
        const etapas = tarjeta.dataset.etapas?.split(' ') ?? [];
        const coincideFamilia = familiaActiva === '' || tarjeta.dataset.familia === familiaActiva;
        const coincideEtapa = etapaActiva === '' || etapas.includes(etapaActiva);
        const coincide = coincideFamilia && coincideEtapa;
        tarjeta.classList.toggle('hidden', !coincide);
        if (coincide) visibles += 1;
      });

      botonesFamilia.forEach((boton) =>
        boton.setAttribute('aria-pressed', String((boton.dataset.valor ?? '') === familiaActiva)),
      );
      botonesEtapa.forEach((boton) =>
        boton.setAttribute('aria-pressed', String((boton.dataset.valor ?? '') === etapaActiva)),
      );

      if (conteo !== null) {
        conteo.textContent =
          visibles === 1 ? singular : plural.replace('{n}', String(visibles));
      }

      sinResultados?.classList.toggle('hidden', visibles > 0);
      limpiar?.classList.toggle('hidden', familiaActiva === '' && etapaActiva === '');

      if (actualizarUrl) {
        const url = new URL(window.location.href);
        familiaActiva === ''
          ? url.searchParams.delete('familia')
          : url.searchParams.set('familia', familiaActiva);
        etapaActiva === ''
          ? url.searchParams.delete('etapa')
          : url.searchParams.set('etapa', etapaActiva);
        window.history.replaceState({}, '', url);
      }
    };

    const leerUrl = (): void => {
      const parametros = new URLSearchParams(window.location.search);
      const familia = parametros.get('familia') ?? '';
      const etapa = parametros.get('etapa') ?? '';
      familiaActiva = familiasValidas.has(familia) ? familia : '';
      etapaActiva = etapasValidas.has(etapa) ? etapa : '';
      aplicar(familia !== familiaActiva || etapa !== etapaActiva);
    };

    botonesFamilia.forEach((boton) => {
      boton.addEventListener('click', () => {
        familiaActiva = boton.dataset.valor ?? '';
        aplicar();
      });
    });

    botonesEtapa.forEach((boton) => {
      boton.addEventListener('click', () => {
        etapaActiva = boton.dataset.valor ?? '';
        aplicar();
      });
    });

    limpiar?.addEventListener('click', () => {
      familiaActiva = '';
      etapaActiva = '';
      aplicar();
    });

    window.addEventListener('popstate', leerUrl);
    leerUrl();
  }
</script>
