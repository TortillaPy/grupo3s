{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grupo3s",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  }
}
